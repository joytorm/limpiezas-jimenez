---
import Layout from '../../layouts/Layout.astro';
import CTABanner from '../../components/CTABanner.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';

// Process steps for post-construction cleaning
const processSteps = [
  {
    number: 1,
    title: "Inspección y Evaluación",
    description: "Evaluamos el estado de la obra, tipo de residuos y planificamos los métodos y equipos necesarios.",
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 4h.01M9 12h.01m4-.01h.01m2 0h.01M9 16h.01m4-.01h.01m2 0h.01"></path></svg>`
  },
  {
    number: 2,
    title: "Limpieza Gruesa",
    description: "Retirada de escombros, residuos de obra, polvo grueso y materiales sobrantes de la construcción.",
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>`
  },
  {
    number: 3,
    title: "Limpieza Detallada",
    description: "Limpieza profunda de todas las superficies, eliminación de adhesivos, pinturas y residuos finos.",
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>`
  },
  {
    number: 4,
    title: "Acabado Final",
    description: "Pulido y brillo final, limpieza de cristales y entrega del espacio listo para habitar o usar.",
    icon: `<svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.196-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path></svg>`
  }
];

// FAQs specific to post-construction cleaning
const faqs = [
  {
    question: "¿Qué incluye exactamente la limpieza fin de obra?",
    answer: "Incluye: retirada de escombros y residuos de construcción, limpieza profunda de polvo de todas las superficies, eliminación de restos de cemento, pintura y adhesivos, limpieza de cristales interiores y exteriores, aspirado y fregado de suelos, limpieza de sanitarios, y desinfección completa del espacio."
  },
  {
    question: "¿Cuánto tiempo necesitan para limpiar después de una obra?",
    answer: "Depende del tamaño y estado de la obra. Una vivienda estándar suele necesitar 1-2 días, oficinas medianas 2-3 días, y proyectos grandes pueden requerir una semana o más. Evaluamos cada caso específicamente y proporcionamos tiempos realistas en el presupuesto."
  },
  {
    question: "¿Se encargan también de la gestión de residuos?",
    answer: "Sí, gestionamos la retirada y el transporte de todos los residuos generados durante la limpieza. Colaboramos con gestores autorizados y nos encargamos de toda la documentación necesaria para el tratamiento adecuado de los residuos de construcción."
  },
  {
    question: "¿Pueden trabajar cuando la obra aún está en proceso?",
    answer: "Podemos realizar limpiezas intermedias durante el proceso de construcción, especialmente útiles en obras largas. Sin embargo, la limpieza final siempre debe realizarse cuando la obra esté completamente terminada para garantizar los mejores resultados."
  }
];

// Testimonial for this service
const testimonial = {
  name: "Ana Pérez",
  company: "Propietaria Residencial Las Torres",
  testimonial: "Después de una reforma completa de nuestra casa, Limpiezas Jiménez hizo un trabajo increíble. Eliminaron todo el polvo y residuos que parecían imposibles de quitar. Quedó como nueva y pudimos mudarnos sin problemas.",
  avatar: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=150&h=150&fit=crop&crop=face",
  rating: 5
};
---

<Layout 
  title="Limpieza Fin de Obra Madrid - Especialistas Post-Construcción | Limpiezas Jiménez"
  description="Servicio especializado de limpieza fin de obra y post-construcción en Madrid. Eliminamos residuos y dejamos tu espacio listo para habitar. Presupuesto gratis."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-brand-primary to-brand-accent py-32">
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1920&h=1080&fit=crop" 
        alt="Limpieza fin de obra profesional"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-brand-primary/85"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center text-white">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Limpieza<br />
          <span class="text-white/90">Fin de Obra</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-white/90 mb-8 max-w-3xl mx-auto leading-relaxed">
          Limpieza especializada post-construcción. Eliminamos residuos y dejamos tu espacio listo para habitar.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contacto"
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-brand-primary font-bold text-lg rounded-lg hover:bg-gray-50 transition-all duration-300 hover:scale-105"
          >
            Solicitar presupuesto gratuito
          </a>
          
          <a 
            href="tel:+34912345678"
            class="inline-flex items-center justify-center px-8 py-4 border-2 border-white text-white font-bold text-lg rounded-lg hover:bg-white hover:text-brand-primary transition-all duration-300"
          >
            912 345 678
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Description -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-6">
            De Obra a Hogar en Tiempo Récord
          </h2>
          
          <div class="space-y-6 text-secondary text-lg leading-relaxed">
            <p>
              Finalizar una obra es solo el primer paso. La <strong>limpieza post-construcción</strong> es fundamental 
              para poder disfrutar del espacio renovado de forma inmediata y segura. En Limpiezas Jiménez somos 
              especialistas en <strong>transformar espacios recién construidos</strong> en lugares habitables.
            </p>
            
            <p>
              Nuestro equipo especializado utiliza <strong>equipamiento profesional</strong> y técnicas específicas 
              para eliminar polvo de obra, residuos de construcción, restos de pintura, cemento y todo tipo de 
              suciedad generada durante el proceso constructivo.
            </p>
            
            <p>
              No solo limpiamos, <strong>preparamos tu espacio</strong> para que puedas habitarlo inmediatamente con 
              total tranquilidad y seguridad. Trabajamos con constructoras, promotoras y particulares en todo Madrid.
            </p>
          </div>
        </div>
        
        <div class="relative">
          <img 
            src="https://images.unsplash.com/photo-1581578949509-99d5e8e9db35?w=800&h=600&fit=crop" 
            alt="Espacio después de limpieza fin de obra"
            class="rounded-lg shadow-lg"
            loading="lazy"
          />
          <div class="absolute -bottom-6 -right-6 bg-brand-primary text-white p-6 rounded-lg shadow-lg">
            <div class="text-3xl font-bold">48h</div>
            <div class="text-sm">Máximo para entregas</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's Included Section -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">
          ¿Qué incluye nuestro servicio especializado?
        </h2>
        <p class="text-xl text-secondary max-w-3xl mx-auto">
          Limpieza integral y exhaustiva que abarca todos los aspectos post-construcción
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Retirada de Escombros</h3>
          <p class="text-secondary">Eliminación completa de residuos de construcción, escombros y materiales sobrantes.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Limpieza de Polvo</h3>
          <p class="text-secondary">Aspirado especializado y eliminación de polvo fino de obra de todas las superficies.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Eliminación de Residuos</h3>
          <p class="text-secondary">Retirada de restos de cemento, pintura, adhesivos y otros materiales de construcción.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Cristales y Ventanas</h3>
          <p class="text-secondary">Limpieza especializada de cristales, eliminando pegamentos y marcas de la construcción.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Suelos Especializados</h3>
          <p class="text-secondary">Tratamiento específico según tipo de suelo: parquet, gres, piedra natural, etc.</p>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300">
          <div class="w-12 h-12 bg-brand-primary/10 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-brand-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-primary mb-3">Desinfección Final</h3>
          <p class="text-secondary">Desinfección completa del espacio para garantizar un ambiente higiénico y saludable.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Steps -->
  <ProcessSteps 
    title="Nuestro Proceso Especializado"
    subtitle="Metodología profesional que garantiza resultados excepcionales en tiempo récord"
    steps={processSteps} 
  />

  <!-- Benefits Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">
          Ventajas de nuestro servicio especializado
        </h2>
        <p class="text-xl text-secondary max-w-3xl mx-auto">
          Experiencia y equipamiento especializado para los mejores resultados
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="text-center group">
          <div class="bg-bg-secondary rounded-lg p-8 shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
            <div class="w-16 h-16 bg-brand-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Entrega Rápida</h3>
            <p class="text-secondary text-sm">Espacio listo para habitar en tiempo récord sin comprometer la calidad.</p>
          </div>
        </div>

        <div class="text-center group">
          <div class="bg-bg-secondary rounded-lg p-8 shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
            <div class="w-16 h-16 bg-brand-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Equipamiento Especializado</h3>
            <p class="text-secondary text-sm">Maquinaria y productos específicos para limpieza post-construcción.</p>
          </div>
        </div>

        <div class="text-center group">
          <div class="bg-bg-secondary rounded-lg p-8 shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
            <div class="w-16 h-16 bg-brand-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Gestión Integral</h3>
            <p class="text-secondary text-sm">Nos encargamos de todo: limpieza, residuos y documentación necesaria.</p>
          </div>
        </div>

        <div class="text-center group">
          <div class="bg-bg-secondary rounded-lg p-8 shadow-lg group-hover:shadow-xl transition-all duration-300 group-hover:-translate-y-2">
            <div class="w-16 h-16 bg-brand-primary rounded-full mx-auto mb-4 flex items-center justify-center">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-primary mb-3">Listo para Habitar</h3>
            <p class="text-secondary text-sm">Espacio completamente habitable, limpio y seguro tras nuestro servicio.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-20 bg-bg-secondary">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">
          Tarifas Especializadas
        </h2>
        <p class="text-xl text-secondary max-w-3xl mx-auto">
          Precios adaptados al tipo y tamaño de obra, con todo incluido
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <h3 class="text-xl font-semibold text-primary mb-4">Vivienda Estándar</h3>
          <p class="text-muted mb-6">80-120m²</p>
          <div class="text-3xl font-bold text-brand-primary mb-2">Desde 480€</div>
          <p class="text-sm text-secondary mb-6">Servicio completo</p>
          <ul class="text-sm text-secondary space-y-2 mb-8">
            <li>✓ Limpieza integral</li>
            <li>✓ Retirada de residuos</li>
            <li>✓ Cristales incluidos</li>
            <li>✓ 1-2 días de trabajo</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8 text-center border-2 border-brand-primary relative">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-brand-primary text-white px-4 py-1 rounded-full text-sm font-medium">
            Más Popular
          </div>
          <h3 class="text-xl font-semibold text-primary mb-4">Oficina/Local</h3>
          <p class="text-muted mb-6">120-300m²</p>
          <div class="text-3xl font-bold text-brand-primary mb-2">Desde 720€</div>
          <p class="text-sm text-secondary mb-6">Servicio completo</p>
          <ul class="text-sm text-secondary space-y-2 mb-8">
            <li>✓ Limpieza especializada</li>
            <li>✓ Gestión de residuos</li>
            <li>✓ Fachadas acristaladas</li>
            <li>✓ 2-3 días de trabajo</li>
          </ul>
        </div>

        <div class="bg-white rounded-lg shadow-lg p-8 text-center">
          <h3 class="text-xl font-semibold text-primary mb-4">Proyecto Grande</h3>
          <p class="text-muted mb-6">Más de 300m²</p>
          <div class="text-3xl font-bold text-brand-primary mb-2">Desde 1.200€</div>
          <p class="text-sm text-secondary mb-6">Presupuesto personalizado</p>
          <ul class="text-sm text-secondary space-y-2 mb-8">
            <li>✓ Equipo especializado</li>
            <li>✓ Gestión integral</li>
            <li>✓ Coordinación con obra</li>
            <li>✓ Planificación detallada</li>
          </ul>
        </div>
      </div>

      <div class="text-center mt-12">
        <p class="text-muted mb-6">
          * Precios orientativos. El precio final depende del estado de la obra y servicios específicos necesarios.
        </p>
        <a 
          href="/contacto"
