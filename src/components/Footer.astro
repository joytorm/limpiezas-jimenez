---
---

<footer class="bg-gray-900 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Company Info -->
      <div class="col-span-1 lg:col-span-2">
        <h3 class="text-2xl font-bold text-brand-accent mb-4">Limpiezas Jiménez</h3>
        <p class="text-gray-300 mb-4 max-w-md">
          Más de 15 años ofreciendo servicios profesionales de limpieza en Madrid. 
          Calidad garantizada y atención personalizada para empresas y particulares.
        </p>
        
        <div class="space-y-2">
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-accent mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="text-gray-300">Calle Gran Vía 28, 28013 Madrid</span>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-accent mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:+34912345678" class="text-gray-300 hover:text-brand-accent transition-colors">912 345 678</a>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-accent mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:info@limpiezasjimenez.es" class="text-gray-300 hover:text-brand-accent transition-colors">info@limpiezasjimenez.es</a>
          </div>
          
          <div class="flex items-center">
            <svg class="w-5 h-5 text-brand-accent mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-300">Lun-Vie: 7:00-21:00 | Sáb: 8:00-14:00</span>
          </div>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-brand-accent">Nuestros Servicios</h4>
        <ul class="space-y-2">
          <li>
            <a href="/servicios/limpieza-oficinas" class="text-gray-300 hover:text-white transition-colors">
              Limpieza de Oficinas
            </a>
          </li>
          <li>
            <a href="/servicios/limpieza-comunidades" class="text-gray-300 hover:text-white transition-colors">
              Limpieza de Comunidades
            </a>
          </li>
          <li>
            <a href="/servicios/limpieza-cristales" class="text-gray-300 hover:text-white transition-colors">
              Limpieza de Cristales
            </a>
          </li>
          <li>
            <a href="/servicios/limpieza-fin-obra" class="text-gray-300 hover:text-white transition-colors">
              Limpieza Fin de Obra
            </a>
          </li>
          <li>
            <a href="/servicios/limpieza-hogar" class="text-gray-300 hover:text-white transition-colors">
              Limpieza del Hogar
            </a>
          </li>
          <li>
            <a href="/servicios/limpieza-industrial" class="text-gray-300 hover:text-white transition-colors">
              Limpieza Industrial
            </a>
          </li>
        </ul>
      </div>

      <!-- Company & Legal -->
      <div>
        <h4 class="text-lg font-semibold mb-4 text-brand-accent">Empresa</h4>
        <ul class="space-y-2">
          <li>
            <a href="/sobre-nosotros" class="text-gray-300 hover:text-white transition-colors">
              Sobre Nosotros
            </a>
          </li>
          <li>
            <a href="/contacto" class="text-gray-300 hover:text-white transition-colors">
              Contacto
            </a>
          </li>
          <li>
            <a href="/presupuesto" class="text-gray-300 hover:text-white transition-colors">
              Presupuesto Gratuito
            </a>
          </li>
          <li>
            <a href="/politica-privacidad" class="text-gray-300 hover:text-white transition-colors">
              Política de Privacidad
            </a>
          </li>
          <li>
            <a href="/terminos" class="text-gray-300 hover:text-white transition-colors">
              Términos y Condiciones
            </a>
          </li>
        </ul>
        
        <!-- Certification badges -->
        <div class="mt-6">
          <p class="text-sm text-gray-400 mb-2">Certificaciones:</p>
          <div class="flex space-x-2">
            <div class="bg-gray-800 px-3 py-1 rounded text-xs text-gray-300">ISO 9001</div>
            <div class="bg-gray-800 px-3 py-1 rounded text-xs text-gray-300">ISO 14001</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Zonas de cobertura -->
    <div class="mt-8 pt-8 border-t border-gray-700">
      <h4 class="text-lg font-semibold mb-4 text-brand-accent">Zonas de Cobertura en Madrid</h4>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2 text-sm text-gray-300">
        <span>Centro</span>
        <span>Chamberí</span>
        <span>Salamanca</span>
        <span>Retiro</span>
        <span>Arganzuela</span>
        <span>Chamartín</span>
        <span>Tetuán</span>
        <span>Moncloa</span>
        <span>Latina</span>
        <span>Carabanchel</span>
        <span>Usera</span>
        <span>Villaverde</span>
        <span>Vallecas</span>
        <span>Ciudad Lineal</span>
        <span>Hortaleza</span>
        <span>Barajas</span>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-8 border-t border-gray-700 flex flex-col sm:flex-row justify-between items-center">
      <p class="text-gray-400 text-sm">
        © {new Date().getFullYear()} Limpiezas Jiménez Madrid. Todos los derechos reservados.
      </p>
      
      <div class="mt-4 sm:mt-0">
        <p class="text-gray-400 text-sm">
          Empresa fundada en 2009 • Más de 500 clientes satisfechos
        </p>
      </div>
    </div>
  </div>
</footer>